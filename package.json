{
  "name": "billy",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @billy/api --filter @billy/web dev",
    "dev:api": "pnpm --filter @billy/api dev",
    "dev:web": "pnpm --filter @billy/web dev",
    "db:generate": "pnpm --filter @billy/api db:generate",
    "db:migrate": "pnpm --filter @billy/api db:migrate",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "start:demo": "sh scripts/start-demo.sh"
  }
}
