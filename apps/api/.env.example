# Postgres connection
DATABASE_URL=postgres://billy:billy@localhost:5432/billy

# Long random string used to sign login tokens
JWT_SECRET=change-me-to-a-long-random-string

# Where the web app lives (used for share links and Paystack redirects)
WEB_URL=http://localhost:3000
# Allowed browser origins, comma separated
CORS_ORIGINS=http://localhost:3000
PORT=4000

# Paystack secret key. Leave empty to use the built-in test checkout (no real money).
PAYSTACK_SECRET_KEY=
# Billy's cut of each payment, in percent. 0 means everything goes to her.
BILLY_FEE_PERCENT=0

# Termii SMS. Leave empty to print OTP codes and SMS to the API logs instead.
TERMII_API_KEY=
TERMII_SENDER_ID=Billy

# Phone numbers that get admin access, comma separated
ADMIN_PHONES=
