{
  "name": "@billy/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@billy/shared": "workspace:*",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.6.0",
    "pg": "^8.16.0",
    "tsx": "^4.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.0",
    "drizzle-kit": "^0.31.4",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  }
}
